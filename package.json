{
  "name": "dsh-apex",
  "version": "1.0.0",
  "description": "APEX 1.0: native PTC, scoped Agent Teams and generic browser evidence for DeepSeek Harness v0.1.6-alpha.1",
  "type": "module",
  "main": "apex.js",
  "exports": {
    ".": "./apex.js",
    "./apex-v1/*": "./presets/apex-v1/*.mjs"
  },
  "files": [
    "apex.js",
    "cordis.patch.yml",
    "presets/apex-v1",
    "README.md",
    "docs/APEX-1.0.md",
    "LICENSE",
    "NOTICE",
    "docs/PUBLICATION.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "zod": "4.5.4"
  },
  "scripts": {
    "check": "node --test test/apex-v1-*.test.mjs",
    "test": "node --test test/apex-v1-*.test.mjs",
    "check:public": "node scripts/check-publication.mjs"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "agent-preset",
    "apex",
    "ponytail"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-experimental-agent-team": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-experimental-client-ui-agent-team": "0.1.6-alpha.1"
  },
  "packageManager": "pnpm@11.7.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GTC2080/dsh-APEX_Plugin.git"
  }
}
