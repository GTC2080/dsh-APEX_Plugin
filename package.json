{
  "name": "dsh-apex",
  "version": "1.0.1",
  "description": "APEX 1.0.1：原生 PTC、作用域 Agent Teams 与通用浏览器证据，适配 DeepSeek Harness v0.2.0-rc.2",
  "type": "module",
  "main": "apex.js",
  "exports": {
    ".": "./apex.js",
    "./apex-v1/*": "./presets/apex-v1/*.mjs"
  },
  "files": [
    "apex.js",
    "cordis.patch.yml",
    "presets/apex-v1",
    "README.md",
    "ARCHIVE.md",
    "docs/APEX-1.0.md",
    "docs/SEARCH-EXPERIMENT.md",
    "docs/EVIDENCE-FLOW.md",
    "docs/NATIVE-FEEDBACK.md",
    "LICENSE",
    "NOTICE",
    "docs/PUBLICATION.md"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/apex-v1/agent.cordis.yml"
      ]
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "zod": "4.5.4"
  },
  "scripts": {
    "check": "node --test test/apex-v1-*.test.mjs",
    "test": "node --test test/apex-v1-*.test.mjs",
    "check:public": "node scripts/check-publication.mjs"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "agent-preset",
    "apex",
    "ponytail"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-agent-preset": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.0-rc.2",
    "@deepseek-ai/dsh-experimental-agent-team": "0.2.0-rc.2",
    "@deepseek-ai/dsh-experimental-client-ui-agent-team": "0.2.0-rc.2"
  },
  "packageManager": "pnpm@11.7.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GTC2080/dsh-APEX_Plugin.git"
  }
}
